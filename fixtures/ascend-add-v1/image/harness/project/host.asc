#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "add_custom_tiling.h"
#include "add_custom_kernel.asc"

namespace {

bool acl_ok(aclError result, const char* operation)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "%s failed: %d\n", operation, static_cast<int>(result));
    return false;
}

uint64_t checksum(const std::vector<float>& values)
{
    uint64_t value = 1469598103934665603ULL;
    for (float element : values) {
        uint32_t bits = 0;
        std::memcpy(&bits, &element, sizeof(bits));
        value ^= bits;
        value *= 1099511628211ULL;
    }
    return value;
}

}  // namespace

int main()
{
    if (!acl_ok(aclInit(nullptr), "aclInit") || !acl_ok(aclrtSetDevice(0), "aclrtSetDevice")) {
        return 2;
    }
    int64_t available_cores = 0;
    if (!acl_ok(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &available_cores),
                "aclrtGetDeviceInfo") || available_cores <= 0) {
        aclrtResetDevice(0);
        aclFinalize();
        return 2;
    }

    const uint32_t tiles = (ALLOYPORT_ELEMENTS + ALLOYPORT_TILE_ELEMENTS - 1) /
                           ALLOYPORT_TILE_ELEMENTS;
    const uint32_t block_count = std::min<uint32_t>(tiles, static_cast<uint32_t>(available_cores));
    const uint32_t tiles_per_core = (tiles + block_count - 1) / block_count;
    AddTilingData tiling{
        block_count,
        tiles_per_core * ALLOYPORT_TILE_ELEMENTS,
        ALLOYPORT_ELEMENTS - (block_count - 1) * tiles_per_core * ALLOYPORT_TILE_ELEMENTS,
    };

    std::vector<float> x(ALLOYPORT_ELEMENTS);
    std::vector<float> y(ALLOYPORT_ELEMENTS);
    std::vector<float> expected(ALLOYPORT_ELEMENTS);
    std::vector<float> actual(ALLOYPORT_ELEMENTS);
    for (uint32_t index = 0; index < ALLOYPORT_ELEMENTS; ++index) {
        x[index] = static_cast<float>(static_cast<int32_t>(index % 127) - 63);
        y[index] = static_cast<float>(static_cast<int32_t>((index * 3) % 113) - 56);
        expected[index] = x[index] + y[index];
    }

    const size_t bytes = ALLOYPORT_ELEMENTS * sizeof(float);
    void* x_device = nullptr;
    void* y_device = nullptr;
    void* z_device = nullptr;
    void* tiling_device = nullptr;
    aclrtStream stream = nullptr;
    bool ok = acl_ok(aclrtMalloc(&x_device, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(x)") &&
              acl_ok(aclrtMalloc(&y_device, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(y)") &&
              acl_ok(aclrtMalloc(&z_device, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc(z)") &&
              acl_ok(aclrtMalloc(&tiling_device, sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST),
                     "aclrtMalloc(tiling)") &&
              acl_ok(aclrtCreateStream(&stream), "aclrtCreateStream") &&
              acl_ok(aclrtMemcpy(x_device, bytes, x.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE),
                     "aclrtMemcpy(x)") &&
              acl_ok(aclrtMemcpy(y_device, bytes, y.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE),
                     "aclrtMemcpy(y)") &&
              acl_ok(aclrtMemset(z_device, bytes, 0, bytes), "aclrtMemset(z)") &&
              acl_ok(aclrtMemcpy(tiling_device, sizeof(tiling), &tiling, sizeof(tiling),
                                ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy(tiling)");
    if (ok) {
        add_custom_kernel<<<block_count, nullptr, stream>>>(
            static_cast<uint8_t*>(x_device), static_cast<uint8_t*>(y_device),
            static_cast<uint8_t*>(z_device), static_cast<uint8_t*>(tiling_device));
        ok = acl_ok(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") &&
             acl_ok(aclrtMemcpy(actual.data(), bytes, z_device, bytes,
                               ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy(z)");
    }

    if (stream != nullptr) aclrtDestroyStream(stream);
    if (tiling_device != nullptr) aclrtFree(tiling_device);
    if (z_device != nullptr) aclrtFree(z_device);
    if (y_device != nullptr) aclrtFree(y_device);
    if (x_device != nullptr) aclrtFree(x_device);
    aclrtResetDevice(0);
    aclFinalize();
    if (!ok) return 2;

    for (uint32_t index = 0; index < ALLOYPORT_ELEMENTS; ++index) {
        if (actual[index] != expected[index]) {
            std::fprintf(stderr, "mismatch at %u: actual=%g expected=%g\n", index,
                         actual[index], expected[index]);
            return 1;
        }
    }
    std::printf("PASS fixture=ascend-add-v1 elements=%u checksum=%016llx\n",
                ALLOYPORT_ELEMENTS,
                static_cast<unsigned long long>(checksum(actual)));
    return 0;
}
